{
  "name": "patterns-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "description": "@patterns-ui — console/SaaS UI 底座：core 逻辑包 + registry blocks + demo",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm vocab:generate && pnpm --filter @patterns-ui/core build && pnpm registry:build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter demo test:e2e",
    "review": "pnpm --filter demo review",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "registry:build": "tsx registry/scripts/build.ts",
    "vocab:generate": "tsx registry/scripts/generate-blocks.ts",
    "registry:smoke": "node scripts/registry-consumer-smoke.mjs",
    "lint:eslint": "pnpm --filter @patterns-ui/eslint-plugin lint:eslint",
    "slots:check": "pnpm --filter @patterns-ui/eslint-plugin check:slots",
    "registry:freeze": "pnpm --filter @patterns-ui/eslint-plugin freeze:regen",
    "ui:shots": "node scripts/ui-shots.mjs",
    "ui:score": "node scripts/consistency-score.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-tag": "changeset tag"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^3.0.3",
    "@patterns-ui/core": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  }
}
