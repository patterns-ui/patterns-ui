{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/components/blocks/*": ["../../registry/blocks/*"],
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "../../registry/blocks/**/*.ts",
    "../../registry/blocks/**/*.tsx"
  ]
}
